# TravelZync Waitlist Backend Configuration
DJANGO_SECRET_KEY=django-insecure-travelzync-labs-waitlist-key-2026-production-ready
DJANGO_DEBUG=True

# Admin Dashboard Secret Access Key
ADMIN_DASHBOARD_KEY=travelzync_admin_2026

# ==========================================
# MAILING SYSTEM CONFIGURATION
# ==========================================
# For local development, 'console.EmailBackend' prints emails to the terminal.
# In production, set to 'django.core.mail.backends.smtp.EmailBackend'.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (e.g., Gmail, SendGrid, AWS SES)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=travelzynclabs@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=TravelZync Labs <travelzynclabs@gmail.com>
ADMIN_NOTIFICATION_EMAIL=contact@travelzync.com

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Leave blank to use default SQLite, or specify PostgreSQL credentials:
# POSTGRES_DB=travelzync_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
